# E-mail (para recuperação de senha)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu@gmail.com
MAIL_PASSWORD=sua-senha-de-app
MAIL_DEFAULT_SENDER=noreply@meudocmed.com

# Pasta de uploads (padrão: ./uploads)
UPLOAD_FOLDER=
